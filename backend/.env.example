# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Public URL of this API (used for local photo URLs). Optional locally.
SERVER_URL=http://localhost:5000

# ---------- Database ----------
# Local MongoDB:   mongodb://127.0.0.1:27017/lotflow
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lotflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lotflow
# No MongoDB installed? Set this to true (or run "npm run dev:memory") to use an in-memory database.
USE_MEMORY_DB=false
# In development, fall back to the in-memory DB automatically if MONGODB_URI is unreachable.
MEMORY_DB_FALLBACK=true
# Load the demo dataset automatically when the database is empty.
AUTO_SEED=true

# ---------- Auth ----------
# Use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Frontend origin(s) for CORS (comma-separated) ----------
CLIENT_URL=http://localhost:5173

# ---------- Demo mode ----------
# true = one-click demo logins, "Reset demo data" button, seeded enterprise integrations
DEMO_MODE=true

# ---------- AI (optional) ----------
# Leave AI_API_KEY empty to use the built-in LotFlow rules engine (works offline).
# AI_PROVIDER: anthropic | openai | groq
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional model override, e.g. claude-haiku-5-5, gpt-4o-mini, llama-3.3-70b-versatile
AI_MODEL=
AI_TIMEOUT_MS=12000

# ---------- Photo storage (optional) ----------
# Without Cloudinary, photos are saved to backend/uploads and served by the API.
CLOUDINARY_URL=
# or the three separate values:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dealership timezone offset in minutes (IST = 330)
DEALERSHIP_TZ_OFFSET_MIN=330
