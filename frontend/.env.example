# Leave empty for local development: Vite proxies /api, /uploads and /socket.io to http://localhost:5000.
# In production (Vercel), set this to your Render backend URL, e.g. https://lotflow-api.onrender.com
VITE_API_URL=

# Optional: point the local dev proxy at a different backend.
# VITE_DEV_PROXY_TARGET=http://localhost:5000
